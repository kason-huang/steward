diff --git a/steward/src/steward/ego/panda_jobs.py b/steward/src/steward/ego/panda_jobs.py
new file mode 100644
index 0000000000..0b71bab83e
--- /dev/null
+++ b/steward/src/steward/ego/panda_jobs.py
@@ -0,0 +1,446 @@
+"""Episode-bound Panda task receipts, a single policy Job and confirmed stopping."""
+
+from __future__ import annotations
+
+import copy
+from dataclasses import dataclass, field
+import json
+from pathlib import Path
+import threading
+import time
+import uuid
+
+import numpy as np
+
+from steward.ego.panda_policy import SKILL, PolicyFailure, infer, write_json
+from steward.ego.panda_prediction import PandaPrediction
+from steward.ego.skills import Job
+from steward.glrender import encode_image
+from steward.net import HttpError, call
+
+
+def credentials(status):
+    return {key: status[key] for key in ("episodeId", "controlGeneration", "leaseId") if key in status}
+
+
+@dataclass
+class PandaJob(Job):
+    episodeId: int = 0
+    phase: str = "starting"
+    goalStatus: str = "unconfirmed"
+    stopStatus: str = "unknown"
+    reasonCode: str = ""
+    evidence: dict = field(default_factory=dict)
+    actionsApplied: int = 0
+
+    def to_dict(self):
+        return super().to_dict() | {key: copy.deepcopy(getattr(self, key)) for key in (
+            "episodeId", "phase", "goalStatus", "stopStatus", "reasonCode", "evidence", "actionsApplied")}
+
+
+class PandaJobs:
+    """Own all policy control, receipts and cleanup for one robot-local runtime."""
+
+    def __init__(self, runtime, config, out):
+        self.runtime = runtime
+        self.link = runtime.link
+        self.config = config
+        self.out = Path(out).resolve()
+        self.out.mkdir(parents=True, exist_ok=True)
+        self.lock = threading.RLock()
+        self.receipts = {}
+        self.deadlines = {}
+        self.jobs = {}
+        self.current = None
+        self.owner = None
+        self.cancelled = threading.Event()
+        self.finished = threading.Event()
+        self.finished.set()
+        self.thread = None
+        self.lease = None
+        self.revoked = False
+        self.blocked = False
+        self.hold = None
+
+    def control_call(self, operation, body=None):
+        return call("GET" if operation == "status" else "POST", self.link.url + "/control/" + operation,
+                    body, timeout=3)
+
+    def status(self):
+        return self.control_call("status")
+
+    def control(self, action=None, owner=None):
+        if action == "release":
+            with self.lock:
+                if owner != self.owner:
+                    raise PermissionError("Panda control cannot be released by this request")
+                running = self.current is not None and self.current.state == "running"
+            if running:
+                stopped = self.stop()
+                if stopped["stopStatus"] != "confirmed":
+                    return self.control() | {"stopStatus": "unknown"}
+            with self.lock:
+                if owner == self.owner:
+                    self.owner = None
+                return {"owner": self.owner, "blocked": self.blocked}
+        with self.lock:
+            if action == "acquire":
+                if not isinstance(owner, str) or not owner:
+                    raise ValueError("control requires an owner")
+                if self.owner not in (None, owner) or self.current and self.current.state == "running":
+                    raise PermissionError("Panda control is busy")
+                self.owner = owner
+            elif action is not None:
+                raise ValueError("action must be acquire or release")
+            return {"owner": self.owner, "blocked": self.blocked}
+
+    def predict(self, skill, params):
+        observation, judgment = self.runtime.policy_observation()
+        objects = self.runtime.query()
+        by_id = {obj["id"]: obj for obj in objects}
+        issues = []
+        target, basket = by_id.get(params.get("target")), by_id.get(params.get("on"))
+        if skill != SKILL or set(params) != {"target", "on"}:
+            issues.append("Only libero_pick_place with target and on is supported")
+        if target is None or target["category"] != "alphabet_soup":
+            issues.append("The soup can needs a current unambiguous Ego-State reference")
+        if basket is None or basket["category"] != "basket":
+            issues.append("The basket needs a current unambiguous Ego-State reference")
+        status = self.status()
+        if status["leased"] or self.blocked or self.current and self.current.state == "running":
+            issues.append("Panda control is busy or stopping is unconfirmed")
+        if status["reason"] != "reset" and status["stopState"] == "unknown":
+            issues.append("The controller has not confirmed a stationary state")
+        coverage = None
+        if not issues:
+            try:
+                coverage = PandaPrediction(observation, target["position"], basket["position"]).check(
+                    [[0, 0, 0, 0, 0, 0, -1]])
+            except PolicyFailure as exc:
+                issues.append(str(exc))
+        risk = 1.0 if issues else min(.35, .02 / max(coverage["minimumObservedClearanceM"], .06))
+        identifier = "panda-receipt-" + uuid.uuid4().hex
+        receipt = {
+            "id": identifier, "skill": skill, "params": copy.deepcopy(params), "episodeId": observation["episodeId"],
+            "controlGeneration": status["controlGeneration"], "modelId": self.config.model_id,
+            "calibrationId": observation["calibrationId"], "sourceStep": observation["step"],
+            "expiresAt": observation["stamp"] + self.config.receipt_wall_s,
+            "risk": risk, "maxRisk": .35, "feasible": not issues, "withinRiskLimit": not issues,
+            "issues": issues, "used": False, "plan": {"target": params.get("target"), "support": params.get("on"),
+                "coverage": coverage, "prefixSize": self.config.prefix_size, "maxActions": self.config.max_actions,
+                "maxWallS": self.config.max_wall_s},
+        }
+        with self.lock:
+            self.receipts[identifier] = receipt
+            self.deadlines[identifier] = time.monotonic() + self.config.receipt_wall_s
+        return copy.deepcopy(receipt)
+
+    def receipt(self, identifier):
+        with self.lock:
+            receipt = copy.deepcopy(self.receipts[identifier])
+            status = self.status()
+            receipt["now"] = status["step"] * .002
+            receipt["expired"] = (time.monotonic() >= self.deadlines[identifier]
+                                  or receipt["episodeId"] != status["episodeId"]
+                                  or not receipt["used"] and receipt["controlGeneration"] != status["controlGeneration"])
+            return receipt
+
+    def run(self, identifier, owner=None):
+        observation, _ = self.runtime.policy_observation()
+        with self.lock:
+            receipt = self.receipt(identifier)
+            if self.owner is not None and owner != self.owner:
+                raise PermissionError("Panda is controlled by another owner")
+            if self.blocked or self.current and self.current.state == "running":
+                raise PermissionError("Panda control is busy or stopping is unconfirmed")
+            if receipt["used"] or receipt["expired"] or not receipt["withinRiskLimit"]:
+                raise PermissionError("Receipt is infeasible, used, expired or outside its risk limit")
+            if (receipt["calibrationId"] != observation["calibrationId"]
+                    or receipt["sourceStep"] != observation["step"]):
+                raise PermissionError("Receipt observation changed, predict again")
+            job = PandaJob(id="panda-job-" + uuid.uuid4().hex, skill=SKILL, receipt=identifier,
+                           started=observation["stamp"], episodeId=observation["episodeId"])
+            folder = self.out / job.id
+            folder.mkdir()
+            for name in ("external", "wrist"):
+                (folder / name).mkdir()
+            self.lease = credentials(self.control_call("acquire", credentials(self.status())
+                                                      | {"ttlS": 30, "policy": "libero-task"}))
+            self.current = job
+            self.jobs[job.id] = job
+            self.receipts[identifier].update(used=True, job=job.id)
+            self.cancelled = threading.Event()
+            self.finished = threading.Event()
+            self.revoked = False
+            self.hold = "policy/" + job.id
+            try:
+                self.link.arm(self.hold, observation["stamp"])
+                self.thread = threading.Thread(target=self._execute, args=(job,), name=job.id, daemon=True)
+                self.thread.start()
+            except Exception as exc:
+                self.cancelled.set()
+                cleanup = {}
+                try:
+                    self._revoke()
+                except Exception as revoke_error:
+                    cleanup["stopError"] = str(revoke_error)
+                try:
+                    self.link.release(self.hold)
+                except Exception as release_error:
+                    cleanup["clockReleaseError"] = str(release_error)
+                job.state = "failed"
+                job.phase = "finished"
+                job.reasonCode = "start_failed"
+                job.message = str(exc)
+                job.evidence = cleanup
+                job.finished = observation["stamp"]
+                self.blocked = True
+                self.finished.set()
+                write_json(folder / "job.json", job.to_dict())
+                raise
+            return job.to_dict()
+
+    def job(self, identifier):
+        with self.lock:
+            return self.jobs[identifier].to_dict()
+
+    def wait(self, identifier, timeout=120):
+        if not 0 <= timeout <= 600:
+            raise ValueError("wait timeout must be between 0 and 600 seconds")
+        deadline = time.monotonic() + timeout
+        while time.monotonic() < deadline:
+            result = self.job(identifier)
+            if result["state"] != "running":
+                return result
+            self.finished.wait(min(.05, max(0, deadline - time.monotonic())))
+        return self.job(identifier)
+
+    def _revoke(self):
+        with self.lock:
+            if self.lease is not None and not self.revoked:
+                result = self.control_call("stop", self.lease)
+                self.revoked = True
+                return result
+            return self.status()
+
+    def stop(self):
+        with self.lock:
+            job = self.current
+            if job is None or job.state != "running":
+                try:
+                    status = self.status()
+                    if self.blocked and status["leased"] and self.lease is not None:
+                        status = self._revoke()
+                    confirmed = not status["leased"] and status["stopState"] == "stopped"
+                    if self.blocked and not status["leased"] and not confirmed:
+                        hold = "stop-recovery/" + uuid.uuid4().hex
+                        self.link.arm(hold, status["step"] * .002)
+                        deadline = time.monotonic() + self.config.stop_wall_s
+                        try:
+                            for _ in range(100):
+                                if time.monotonic() >= deadline:
+                                    break
+                                self._wait_clock(status["step"] + 25, hold, deadline, stopping=True)
+                                status = self.status()
+                                if not status["leased"] and status["stopState"] == "stopped":
+                                    confirmed = True
+                                    break
+                        finally:
+                            self.link.release(hold)
+                except Exception as exc:
+                    self.blocked = True
+                    return {"stopped": None, "stopStatus": "unknown", "message": str(exc)}
+                self.blocked = not confirmed
+                return {"stopped": None, "stopStatus": "confirmed" if confirmed else "unknown"}
+            self.cancelled.set()
+            try:
+                self._revoke()
+            except Exception:
+                self.blocked = True
+        result = self.wait(job.id, self.config.stop_wall_s)
+        if result["state"] == "running":
+            with self.lock:
+                self.blocked = True
+        return {"stopped": job.id, "stopStatus": result["stopStatus"], "job": result}
+
+    def close(self):
+        self.stop()
+        if self.thread is not None and self.thread.ident is not None:
+            self.thread.join(timeout=self.config.stop_wall_s)
+
+    def _keep_alive(self, job, done):
+        while not done.wait(.35):
+            try:
+                self.link.renew(self.hold)
+                with self.lock:
+                    if not self.revoked and not self.cancelled.is_set():
+                        self.control_call("renew", self.lease | {"ttlS": 30})
+            except Exception as exc:
+                with self.lock:
+                    if not job.reasonCode:
+                        job.reasonCode = "lease_lost"
+                        job.message = str(exc)
+                self.cancelled.set()
+                return
+
+    def _wait_clock(self, step, hold, deadline, *, stopping=False):
+        """Wait within the caller's wall deadline even when simulation cannot advance."""
+        while True:
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                raise PolicyFailure("stop_timeout" if stopping else "execution_timeout",
+                                    "Panda clock wait exceeded its wall deadline")
+            if not stopping and self.cancelled.is_set():
+                raise PolicyFailure("cancelled", "Panda clock wait cancelled")
+            timeout = min(.25, remaining)
+            try:
+                call("POST", self.link.url + "/clock/wait", {"hold": hold, "until": step * .002,
+                     "timeoutS": timeout, "rank": 0, "pulls": True}, timeout=timeout + .5)
+                return
+            except HttpError as exc:
+                if exc.status != 504:
+                    raise
+
+    def _advance(self, step, deadline, *, stopping=False):
+        self._wait_clock(step, self.hold, deadline, stopping=stopping)
+        status = self.status()
+        if status["episodeId"] != self.current.episodeId or status["step"] != step:
+            raise PolicyFailure("episode_changed", "Policy clock moved to another episode or step")
+        return status
+
+    def _record_observation(self, observation, folder, index):
+        for role in ("external", "wrist"):
+            (folder / role / f"{index:04d}.png").write_bytes(
+                encode_image(observation["images"][role]))
+        metadata = {key: observation[key] for key in (
+            "episodeId", "step", "stamp", "encoders", "tool", "hand", "cameras", "calibrationId",
+            "toolRig", "selfCollision", "selfVisual")}
+        metadata["judgment"] = copy.deepcopy(self.runtime.latest["judgment"])
+        sensors = folder / "sensors"
+        sensors.mkdir(exist_ok=True)
+        np.savez_compressed(sensors / f"{index:04d}.npz", metadata=json.dumps(metadata),
+                            external=observation["images"]["external"], wrist=observation["images"]["wrist"],
+                            external_depth=observation["depth"]["external"], wrist_depth=observation["depth"]["wrist"])
+        with (folder / "observations.jsonl").open("a") as stream:
+            stream.write(json.dumps({"frame": index, "step": observation["step"],
+                                     "stamp": observation["stamp"], "judgment": metadata["judgment"]}) + "\n")
+
+    def _execute(self, job):
+        folder = self.out / job.id
+        keeper_done = threading.Event()
+        keeper = threading.Thread(target=self._keep_alive, args=(job, keeper_done), name="panda-lease", daemon=True)
+        began = time.monotonic()
+        reason = "execution_limit"
+        try:
+            keeper.start()
+            write_json(folder / "receipt.json", self.receipts[job.receipt])
+            observation, judgment = self.runtime.policy_observation(force=True)
+            self._record_observation(observation, folder, 0)
+            with (folder / "actions.jsonl").open("w", buffering=1) as log, \
+                    (folder / "submissions.jsonl").open("w", buffering=1) as submissions:
+                prefix_index = 0
+                while job.actionsApplied < self.config.max_actions:
+                    if self.cancelled.is_set():
+                        raise PolicyFailure(job.reasonCode or "cancelled", job.message or "Operator stopped the task")
+                    if time.monotonic() - began >= self.config.max_wall_s:
+                        break
+                    job.phase = "waiting_inference"
+                    actions, reply = infer(self.config, observation, folder / f"prefix-{prefix_index:03d}", self.cancelled)
+                    prefix = np.clip(actions[:min(self.config.prefix_size, self.config.max_actions - job.actionsApplied)], -1, 1)
+                    objects = self.runtime.task_positions()
+                    job.phase = "checking_actions"
+                    prediction = PandaPrediction(observation, *objects).check(prefix)
+                    write_json(folder / f"prefix-{prefix_index:03d}" / "prediction.json", prediction)
+                    source = observation
+                    for raw, action in zip(actions, prefix):
+                        if self.cancelled.is_set():
+                            raise PolicyFailure(job.reasonCode or "cancelled", "Task cancelled before action")
+                        if observation["episodeId"] != job.episodeId:
+                            raise PolicyFailure("episode_changed", "Episode changed during policy execution")
+                        PandaPrediction(observation, *self.runtime.task_positions()).check([action])
+                        job.phase = "executing_actions"
+                        with self.lock:
+                            if self.cancelled.is_set() or self.revoked:
+                                raise PolicyFailure("cancelled", "Control was revoked before submission")
+                            start = self.control_call("action", self.lease | {
+                                "sequence": job.actionsApplied, "action": action.tolist(),
+                                "observationId": source["observationId"]})["step"]
+                            submissions.write(json.dumps({"sequence": job.actionsApplied, "prefix": prefix_index,
+                                "sourceStep": source["step"], "episodeId": job.episodeId,
+                                "controlGeneration": self.lease["controlGeneration"], "startStep": start,
+                                "plannedEndStep": start + 25, "raw_action": raw.tolist(),
+                                "applied_action": action.tolist()}) + "\n")
+                        status = self._advance(start + 25, began + self.config.max_wall_s)
+                        completed = status["lastCompleted"]
+                        expected = {"sequence": job.actionsApplied, "controlGeneration": self.lease["controlGeneration"],
+                                    "startStep": start, "plannedEndStep": start + 25, "endStep": start + 25}
+                        if completed != expected:
+                            write_json(folder / "interrupted-action.json", {"expected": expected, "control": status})
+                            raise PolicyFailure("cancelled" if self.cancelled.is_set() else "action_not_applied",
+                                                "Action completion receipt was interrupted")
+                        log.write(json.dumps({"sequence": job.actionsApplied, "prefix": prefix_index,
+                            "sourceStep": source["step"], "episodeId": job.episodeId, "raw_action": raw.tolist(),
+                            "applied_action": action.tolist(), "receipt": completed,
+                            "prediction": prediction, "site_position": status["sitePosition"]}) + "\n")
+                        job.actionsApplied += 1
+                        observation, judgment = self.runtime.policy_observation(force=True)
+                        self._record_observation(observation, folder, job.actionsApplied)
+                        write_json(folder / "latest-judgment.json", judgment)
+                    prefix_index += 1
+                    if judgment["grasp"] == "confirmed" and judgment["placement"] == "confirmed":
+                        job.goalStatus = "achieved"
+                        job.evidence = judgment
+                        reason = "goal_achieved"
+                        break
+                if job.goalStatus != "achieved" and judgment["placement"] == "failed":
+                    job.goalStatus = "not_achieved"
+        except PolicyFailure as exc:
+            with self.lock:
+                reason = job.reasonCode or exc.code
+                if not job.reasonCode:
+                    job.message = str(exc)
+        except Exception as exc:
+            reason = "execution_error"
+            job.message = f"{type(exc).__name__}: {exc}"
+        finally:
+            job.phase = "stopping"
+            try:
+                self._revoke()
+                start = self.status()["step"]
+                stop_deadline = time.monotonic() + self.config.stop_wall_s
+                status = self.status()
+                for index in range(100):
+                    if time.monotonic() >= stop_deadline:
+                        break
+                    status = self._advance(start + (index + 1) * 25, stop_deadline, stopping=True)
+                    observed, judgment = self.runtime.policy_observation(force=True)
+                    self._record_observation(observed, folder, job.actionsApplied + index + 1)
+                    if index >= 19 and status["stopState"] == "stopped":
+                        break
+                job.stopStatus = "confirmed" if not status["leased"] and status["stopState"] == "stopped" else "unknown"
+                write_json(folder / "stop.json", status)
+            except Exception as exc:
+                job.stopStatus = "unknown"
+                job.evidence["stopError"] = str(exc)
+            try:
+                self.link.release(self.hold)
+            except Exception as exc:
+                job.stopStatus = "unknown"
+                job.evidence["clockReleaseError"] = str(exc)
+            keeper_done.set()
+            if keeper.ident is not None:
+                keeper.join(timeout=4)
+            if keeper.is_alive():
+                job.stopStatus = "unknown"
+                job.evidence["leaseCleanupError"] = "Lease worker did not finish"
+            with self.lock:
+                self.blocked = self.blocked or job.stopStatus != "confirmed"
+                job.reasonCode = reason
+                job.state = ("succeeded" if reason == "goal_achieved" and not self.blocked else
+                             "stopped" if reason == "cancelled" and not self.blocked else "failed")
+                job.phase = "finished"
+                job.finished = self.runtime.sensor.observation["stamp"]
+                if not job.message:
+                    job.message = reason
+                write_json(folder / "job.json", job.to_dict())
+                self.finished.set()
diff --git a/steward/src/steward/ego/panda_observation.py b/steward/src/steward/ego/panda_observation.py
new file mode 100644
index 0000000000..56198ffb77
--- /dev/null
+++ b/steward/src/steward/ego/panda_observation.py
@@ -0,0 +1,93 @@
+"""Decode Panda sensor packets and compute robot poses from calibrated encoder chains."""
+
+from __future__ import annotations
+
+import base64
+from io import BytesIO
+import math
+
+import numpy as np
+from PIL import Image
+
+from steward.ego.estimator import _apply_joint
+from steward.math3d import pose_compose
+
+
+def rig_pose(rig, encoders):
+    result = {"p": [0.0, 0.0, 0.0], "q": [1.0, 0.0, 0.0, 0.0]}
+    for node in rig["chain"]:
+        if "joint" in node:
+            joint = {"type": node.get("type", "revolute"), "origin": {"value": node["origin"]}, "axis": node["axis"]}
+            result = _apply_joint(result, joint, encoders[node["joint"]]["position"])
+        else:
+            result = pose_compose(result, node["origin"])
+    return pose_compose(result, rig["mount"])
+
+
+class PandaObservationRuntime:
+    """Observation-only Panda consumer using the same robot link as the Ego Runtime."""
+
+    def __init__(self, link):
+        self.link = link
+        self.last_key = None
+        self.observation = None
+
+    def read(self, force=False):
+        packet = self.link.panda_observation(None if force else self.last_key)
+        if packet.get("unchanged"):
+            return None
+        key = packet["episodeId"], packet["step"]
+        if self.last_key is not None and (key < self.last_key or key == self.last_key and not force):
+            return None
+        calibration = packet["calibration"]
+        encoders = packet["encoders"]
+        images = {}
+        depth = {}
+        cameras = {}
+        for role, rig in calibration["cameras"].items():
+            rgb_data = packet.get("images", {}).get(role)
+            depth_data = packet.get("depthMm", {}).get(role)
+            if rgb_data is None or depth_data is None:
+                images[role] = np.zeros((rig["height"], rig["width"], 3), dtype=np.uint8)
+                depth[role] = np.zeros((rig["height"], rig["width"]), dtype=np.float32)
+                cameras[role] = {"pose": rig_pose(rig, encoders), "K": rig["K"]}
+                continue
+            with Image.open(BytesIO(base64.b64decode(rgb_data, validate=True))) as image:
+                if image.mode != "RGB" or image.size != (rig["width"], rig["height"]):
+                    raise ValueError(f"Unexpected {role} camera image format")
+                images[role] = np.array(image)
+            with Image.open(BytesIO(base64.b64decode(depth_data, validate=True))) as image:
+                if image.size != (rig["width"], rig["height"]):
+                    raise ValueError(f"Unexpected {role} depth image format")
+                depth[role] = np.asarray(image, dtype=np.float32) / 1000
+            cameras[role] = {"pose": rig_pose(rig, encoders), "K": rig["K"]}
+        self.observation = {
+            "episodeId": key[0], "step": key[1], "stamp": packet["stamp"],
+            "calibrationId": packet["calibrationId"], "encoders": encoders,
+            "observationId": packet.get("observationId"),
+            "images": images, "depth": depth, "cameras": cameras,
+            "tool": rig_pose(calibration["tool"], encoders),
+            "hand": rig_pose(calibration["hand"], encoders),
+            "toolRig": calibration["tool"],
+            "selfCollision": calibration["selfCollision"],
+            "selfVisual": calibration["selfVisual"],
+        }
+        self.last_key = key
+        return self.observation
+
+
+def policy_inputs(observation):
+    """Produce the vision and proprioception fields of the pinned LIBERO policy."""
+    images = {}
+    if any(role not in observation["images"] or not observation["images"][role].any()
+           for role in ("external", "wrist")):
+        raise ValueError("Panda policy preview requires both RGB views")
+    for role, key in (("external", "observation/image"), ("wrist", "observation/wrist_image")):
+        image = Image.fromarray(observation["images"][role]).transpose(Image.Transpose.FLIP_LEFT_RIGHT)
+        images[key] = np.array(image.resize((224, 224), Image.Resampling.BILINEAR))
+    w, *axis = observation["hand"]["q"]
+    w = min(1.0, max(-1.0, w))
+    denominator = math.sqrt(1.0 - w * w)
+    rotation = np.zeros(3) if not denominator else np.asarray(axis) * (2 * math.acos(w) / denominator)
+    fingers = [observation["encoders"][f"gripper0_finger_joint{i}"]["position"] for i in (1, 2)]
+    return images | {"observation/state": np.array([*observation["tool"]["p"], *rotation, *fingers])}
diff --git a/steward/src/steward/ego/panda_perception.py b/steward/src/steward/ego/panda_perception.py
new file mode 100644
index 0000000000..d02a07db0c
--- /dev/null
+++ b/steward/src/steward/ego/panda_perception.py
@@ -0,0 +1,181 @@
+"""Task-specific RGB-D evidence for the LIBERO soup can and basket."""
+
+from __future__ import annotations
+
+from collections import deque
+
+import numpy as np
+
+from steward.math3d import matrix_from_quat
+
+# These priors bound the tabletop and the appearance of this task's objects.
+# No reset pose or simulator object identifier is used by the observer.
+VISIBLE_RANGE = 0.45
+EVIDENCE_WINDOW = 0.20
+
+
+def cloud(depth, camera):
+    y, x = np.indices(depth.shape)
+    k = np.asarray(camera["K"])
+    points = np.stack(((x - k[0, 2]) * depth / k[0, 0],
+                       -(y - k[1, 2]) * depth / k[1, 1], -depth), axis=-1)
+    return points @ matrix_from_quat(camera["pose"]["q"]).T + camera["pose"]["p"]
+
+
+def groups(points, pitch=0.015):
+    """Connected bins in the table plane, with each point assigned to its original bin."""
+    if not len(points):
+        return []
+    cells = np.floor(points[:, :2] / pitch).astype(int)
+    members = {}
+    for index, cell in enumerate(map(tuple, cells)):
+        members.setdefault(cell, []).append(index)
+    clusters = []
+    while members:
+        cell, indices = members.popitem()
+        pending = [cell]
+        while pending:
+            x, y = pending.pop()
+            for dx, dy in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                neighbor = x + dx, y + dy
+                found = members.pop(neighbor, None)
+                if found is not None:
+                    pending.append(neighbor)
+                    indices.extend(found)
+        clusters.append(points[indices])
+    return clusters
+
+
+def external_objects(rgb, xyz, previous_can):
+    r, g, b = rgb.astype(np.int16).transpose(2, 0, 1)
+    x, y, z = xyz.transpose(2, 0, 1)
+    valid = (np.abs(x) < VISIBLE_RANGE) & (np.abs(y) < VISIBLE_RANGE)
+    blue = valid & (b > r + 16) & (b > g + 8) & (z > .022) & (z < .34)
+    cans = []
+    for points in groups(xyz[blue], pitch=.012):
+        if len(points) >= 35 and np.ptp(points[:, 2]) >= .018 and np.ptp(points[:, 1]) >= .025:
+            position = np.median(points, axis=0)
+            position[0] -= .022  # Front camera sees the near face of the cylindrical label.
+            if previous_can is None or np.linalg.norm(position - previous_can) < .20:
+                cans.append((len(points), position))
+    can = max(cans, key=lambda entry: entry[0])[1] if cans else None
+
+    white = valid & (r > 140) & (np.abs(r - b) < 32) & (z > .115) & (z < .145)
+    rims = []
+    for points in groups(xyz[white], pitch=.024):
+        if len(points) < 200:
+            continue
+        lower, upper = np.quantile(points, [.01, .99], axis=0)
+        if .10 < upper[0] - lower[0] < .20 and .12 < upper[1] - lower[1] < .20:
+            rims.append((len(points), (lower[:2] + upper[:2]) / 2, float(np.median(points[:, 2]))))
+    basket = max(rims, key=lambda entry: entry[0])[1:] if rims else None
+    return can, basket
+
+
+def wrist_can_top(rgb, xyz, center, rim_height):
+    x, y, z = xyz.transpose(2, 0, 1)
+    light = rgb.max(axis=-1)
+    gray = light.astype(np.int16) - rgb.min(axis=-1) < 27
+    region = (np.abs(x - center[0]) < .072) & (np.abs(y - center[1]) < .072)
+    dark = region & gray & (light < 115) & (z > .045) & (z < rim_height - .017)
+    candidates = []
+    points = xyz[dark]
+    # Slice by height first, so vertical basket walls do not connect separate surfaces.
+    for height in np.arange(.049, rim_height - .016, .005):
+        for top in groups(points[np.abs(points[:, 2] - height) < .003], pitch=.005):
+            if len(top) < 90:
+                continue
+            width = np.ptp(top[:, :2], axis=0)
+            if min(width) >= .020 and max(width) <= .083:
+                candidates.append((len(top), np.median(top, axis=0)))
+    return max(candidates, key=lambda entry: entry[0])[1] if candidates else None
+
+
+class PandaEvidence:
+    def __init__(self):
+        self.last_can = None
+        self.basket = None
+        self.start_can = None
+        self.min_width = .08
+        self.last_held = None
+        self.release = None
+        self.grasp = "unconfirmed"
+        self.held = deque(maxlen=12)
+        self.failed = deque(maxlen=12)
+        self.placed = deque(maxlen=12)
+        self.last_stamp = None
+
+    @staticmethod
+    def stable(rows):
+        if len(rows) < 3 or rows[-1][0] - rows[0][0] < EVIDENCE_WINDOW:
+            return False
+        points = np.array([row[1] for row in rows])
+        return bool(np.linalg.norm(np.ptp(points, axis=0)) <= .025)
+
+    def update(self, observation, width):
+        stamp = observation["stamp"]
+        if self.last_stamp is not None and stamp - self.last_stamp > .6:
+            self.held.clear()
+            self.failed.clear()
+            self.placed.clear()
+        self.last_stamp = stamp
+        tool = np.array(observation["tool"]["p"])
+        images, depth, cameras = (observation[k] for k in ("images", "depth", "cameras"))
+        if not all(np.any(images[role]) and np.any(depth[role]) for role in ("external", "wrist")):
+            self.held.clear()
+            self.failed.clear()
+            self.placed.clear()
+            return None, self.basket, "unconfirmed", "unconfirmed", "missing_visual_evidence"
+        external = cloud(depth["external"], cameras["external"])
+        can, basket = external_objects(images["external"], external, self.last_can)
+        if basket is not None and (self.basket is None or np.linalg.norm(basket[0] - self.basket[0]) < .05):
+            self.basket = basket
+        self.min_width = min(self.min_width, width)
+        if can is not None:
+            self.last_can = can
+            if self.start_can is None:
+                self.start_can = can
+        closed = width < .071
+        opened = width >= .075 and self.min_width < .071
+        near = can is not None and np.linalg.norm(can - tool) < .09
+        if closed and near and can[2] > self.start_can[2] + .075:
+            self.held.append((stamp, can - tool))
+            self.last_held = can
+            if self.stable(self.held):
+                self.grasp = "confirmed"
+        else:
+            self.held.clear()
+        if (self.grasp != "confirmed" and self.min_width < .071 and can is not None
+                and tool[2] > can[2] + .09 and can[2] < .09):
+            self.failed.append((stamp, can))
+            if self.stable(self.failed):
+                self.grasp = "failed"
+        else:
+            self.failed.clear()
+        if opened and self.grasp == "confirmed" and self.release is None:
+            self.release = self.last_held
+        placement = "unconfirmed"
+        reason = "awaiting_visible_post_release_evidence"
+        if opened and self.release is not None and self.basket is not None:
+            center, rim = self.basket
+            near_basket = np.linalg.norm(self.release[:2] - center) < .13
+            target = center if near_basket else self.release[:2]
+            wrist = cloud(depth["wrist"], cameras["wrist"])
+            top = wrist_can_top(images["wrist"], wrist, target, rim)
+            # The task's cylinder height gives a centre estimate from its visible lid.
+            # Withdrawal depends on clearance from that estimate, including lower retreats.
+            center_estimate = top - [0, 0, .0375] if top is not None else None
+            if (top is not None and np.linalg.norm(top[:2] - self.release[:2]) < .13
+                    and np.linalg.norm(tool - center_estimate) >= .08):
+                inside = bool(np.all(np.abs(top[:2] - center) < .058))
+                self.placed.append((stamp, top))
+                if self.stable(self.placed):
+                    placement = "confirmed" if inside else "failed"
+                    reason = "stable_visible_can_below_rim" if inside else "stable_visible_can_outside_basket"
+                    can = top
+            else:
+                self.placed.clear()
+        elif opened and self.grasp == "failed" and can is not None and self.basket is not None:
+            if np.linalg.norm(can[:2] - self.basket[0]) > .13:
+                placement, reason = "failed", "can_remained_outside_basket"
+        return can, self.basket, self.grasp, placement, reason
diff --git a/steward/src/steward/ego/panda_policy.py b/steward/src/steward/ego/panda_policy.py
new file mode 100644
index 0000000000..9be7d87570
--- /dev/null
+++ b/steward/src/steward/ego/panda_policy.py
@@ -0,0 +1,105 @@
+"""Configured OpenPI requests and robot-side policy execution records."""
+
+from __future__ import annotations
+
+import base64
+from dataclasses import dataclass
+import json
+from pathlib import Path
+import subprocess
+import time
+import tomllib
+
+import numpy as np
+
+from steward.ego.panda_observation import policy_inputs
+from steward.glrender import encode_image
+
+SKILL = "libero_pick_place"
+PROMPT = "pick up the alphabet soup and place it in the basket"
+
+
+def write_json(path, value):
+    path.write_text(json.dumps(value, indent=2, allow_nan=False) + "\n")
+
+
+@dataclass(frozen=True)
+class PandaPolicyConfig:
+    client_command: tuple[str, ...]
+    port: int
+    model_id: str
+    request_timeout_s: float = 15.0
+    max_actions: int = 280
+    max_wall_s: float = 420.0
+    prefix_size: int = 5
+    receipt_wall_s: float = 30.0
+    stop_wall_s: float = 20.0
+
+    def __post_init__(self):
+        if not self.client_command or not all(isinstance(item, str) and item for item in self.client_command):
+            raise ValueError("Panda policy requires a client command")
+        if type(self.port) is not int or not 1 <= self.port <= 65535 or not self.model_id:
+            raise ValueError("Panda policy identity or port is invalid")
+        if not 0 < self.request_timeout_s < 20 or not 0 < self.receipt_wall_s <= 120:
+            raise ValueError("Panda request and receipt deadlines are invalid")
+        if (type(self.prefix_size) is not int or not 1 <= self.prefix_size <= 5
+                or type(self.max_actions) is not int or not 1 <= self.max_actions <= 280
+                or not 0 < self.max_wall_s <= 420 or not 0 < self.stop_wall_s <= 30):
+            raise ValueError("Panda policy execution budget is invalid")
+
+    @classmethod
+    def load(cls, path):
+        values = tomllib.loads(Path(path).read_text())["policy"]
+        values["client_command"] = tuple(values["client_command"])
+        return cls(**values)
+
+
+class PolicyFailure(Exception):
+    def __init__(self, code, message):
+        super().__init__(message)
+        self.code = code
+
+
+def infer(config, observation, folder, cancelled):
+    """Run the pinned client with one in-flight request and cancellable wall deadline."""
+    folder.mkdir()
+    inputs = policy_inputs(observation)
+    payload = {
+        "episodeId": observation["episodeId"], "step": observation["step"], "prompt": PROMPT,
+        "observation/state": inputs["observation/state"].tolist(),
+        **{key: base64.b64encode(encode_image(inputs[key])).decode("ascii")
+           for key in ("observation/image", "observation/wrist_image")},
+    }
+    source, target = folder / "observation.json", folder / "inference.json"
+    write_json(source, payload)
+    command = [*config.client_command, str(config.port), str(source), str(target)]
+    started = time.monotonic()
+    with (folder / "client.log").open("w") as log:
+        process = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=log, stderr=log)
+        try:
+            while process.poll() is None:
+                if cancelled.wait(.025):
+                    raise PolicyFailure("cancelled", "Policy request cancelled")
+                if time.monotonic() - started >= config.request_timeout_s:
+                    raise PolicyFailure("inference_timeout", "Policy request exceeded its wall deadline")
+            if cancelled.is_set():
+                raise PolicyFailure("cancelled", "Policy reply arrived after cancellation")
+            if process.returncode:
+                raise PolicyFailure("inference_unavailable", f"Policy client exited with {process.returncode}")
+        finally:
+            if process.poll() is None:
+                process.terminate()
+                try:
+                    process.wait(timeout=1)
+                except subprocess.TimeoutExpired:
+                    process.kill()
+                    process.wait()
+    try:
+        result = json.loads(target.read_text())
+        actions = np.asarray(result["actions"], dtype=float)
+    except (OSError, ValueError, KeyError, TypeError) as exc:
+        raise PolicyFailure("invalid_action", f"Invalid policy reply: {exc}") from exc
+    if (actions.ndim != 2 or actions.shape[0] < config.prefix_size or actions.shape[1] != 7
+            or not np.isfinite(actions).all()):
+        raise PolicyFailure("invalid_action", "Expected a finite sequence of seven-dimensional actions")
+    return actions, result
diff --git a/steward/src/steward/ego/panda_prediction.py b/steward/src/steward/ego/panda_prediction.py
new file mode 100644
index 0000000000..37d6494c36
--- /dev/null
+++ b/steward/src/steward/ego/panda_prediction.py
@@ -0,0 +1,173 @@
+"""Panda kinematic and observed RGB-D collision checks for the fixed task."""
+
+from __future__ import annotations
+
+import numpy as np
+
+from steward.ego.estimator import _apply_joint
+from steward.ego.panda_observation import rig_pose
+from steward.ego.panda_perception import cloud
+from steward.ego.panda_policy import PolicyFailure
+from steward.math3d import matrix_from_quat, pose_compose
+from steward.world.panda_control import policy_libero_target
+
+
+def chain_positions(rig, encoders):
+    transform = {"p": [0.0, 0.0, 0.0], "q": [1.0, 0.0, 0.0, 0.0]}
+    positions = []
+    for node in rig["chain"]:
+        if "joint" in node:
+            transform = _apply_joint(transform, {"type": "revolute", "origin": {"value": node["origin"]},
+                                                "axis": node["axis"]}, encoders[node["joint"]]["position"])
+            positions.append(transform["p"])
+        else:
+            transform = pose_compose(transform, node["origin"])
+    positions.append(pose_compose(transform, rig["mount"])["p"])
+    return np.asarray(positions)
+
+
+def segment_distances(points, start, end):
+    delta = end - start
+    factor = np.clip((points - start) @ delta / max(float(delta @ delta), 1e-12), 0, 1)
+    return np.linalg.norm(points - start - factor[:, None] * delta, axis=1)
+
+
+class PandaPrediction:
+    """Checks observed obstacles and differential FK, with task-scoped contact exemptions."""
+
+    def __init__(self, observation, target, basket):
+        self.observation = observation
+        self.rig = observation["toolRig"]
+        self.encoders = {name: dict(value) for name, value in observation["encoders"].items()}
+        self.target = np.asarray(target)
+        self.basket = np.asarray(basket)
+        points = []
+        for role in ("external", "wrist"):
+            depth = observation["depth"][role]
+            xyz = cloud(depth, observation["cameras"][role])[::3, ::3].reshape(-1, 3)
+            valid = (depth[::3, ::3].ravel() > 0) & (np.abs(xyz[:, :2]).max(axis=1) < .5)
+            valid &= (xyz[:, 2] > .015) & (xyz[:, 2] < .6)
+            points.append(xyz[valid])
+        points = np.concatenate(points)
+        if len(points) < 100:
+            raise PolicyFailure("prediction_rejected", "Insufficient RGB-D coverage of the operation area")
+        self.observed_points = len(points)
+        self_points = np.zeros(len(points), dtype=bool)
+        self.boxes = []
+        # RGB-D also sees decorative robot meshes outside collision meshes.
+        # Remove calibrated rendered self geometry before checking external obstacles.
+        for geom in observation["selfVisual"]:
+            transform = rig_pose(geom, self.encoders)
+            rotation = matrix_from_quat(transform["q"])
+            local = (points - transform["p"]) @ rotation
+            center, size = np.asarray(geom["bounds"]).reshape(2, 3)
+            self.boxes.append((np.asarray(transform["p"]), rotation, center, size))
+            self_points |= np.all(np.abs(local - center) <= size + .006, axis=1)
+        self.points = points[~self_points]
+
+    def require_observed(self, point, contact=False):
+        """Require depth or authorized contact for swept samples in the operating volume."""
+        if max(abs(point[0]), abs(point[1])) > .32 or point[2] > .43:
+            return
+        for position, rotation, center, size in self.boxes:
+            if np.all(np.abs((point - position) @ rotation - center) <= size + .006):
+                return
+        if contact and (np.linalg.norm(point - self.target) < .075 or
+                        np.all(np.abs(point[:2] - self.basket[:2]) < .065) and .02 < point[2] < .17):
+            return
+        for role in ("external", "wrist"):
+            camera = self.observation["cameras"][role]
+            local = (point - camera["pose"]["p"]) @ matrix_from_quat(camera["pose"]["q"])
+            distance = -local[2]
+            if distance <= 0:
+                continue
+            k = camera["K"]
+            x = int(round(k[0][0] * local[0] / distance + k[0][2]))
+            y = int(round(-k[1][1] * local[1] / distance + k[1][2]))
+            depth = self.observation["depth"][role]
+            if 0 <= x < depth.shape[1] and 0 <= y < depth.shape[0]:
+                observed = float(depth[y, x])
+                if observed > 0 and distance <= observed + .02:
+                    return
+        raise PolicyFailure("prediction_rejected", f"Swept point lacks visible free-space evidence: {point.tolist()}")
+
+    def joint_target(self, values):
+        pose = rig_pose(self.rig, self.encoders)
+        position = np.asarray(pose["p"])
+        rotation = matrix_from_quat(pose["q"])
+        joints = [node for node in self.rig["chain"] if "joint" in node]
+        jacobian = np.empty((6, len(joints)))
+        epsilon = 1e-5
+        for column, node in enumerate(joints):
+            name = node["joint"]
+            shifted = {key: dict(value) for key, value in self.encoders.items()}
+            shifted[name]["position"] += epsilon
+            next_pose = rig_pose(self.rig, shifted)
+            jacobian[:3, column] = (np.asarray(next_pose["p"]) - position) / epsilon
+            relative = matrix_from_quat(next_pose["q"]) @ rotation.T
+            jacobian[3:, column] = np.array([relative[2, 1] - relative[1, 2],
+                                            relative[0, 2] - relative[2, 0],
+                                            relative[1, 0] - relative[0, 1]]) / (2 * epsilon)
+        displacement = np.asarray([*(.05 * values[:3]), *(.5 * values[3:6])])
+        delta = jacobian.T @ np.linalg.solve(jacobian @ jacobian.T + .002 * np.eye(6), displacement)
+        predicted = {key: dict(value) for key, value in self.encoders.items()}
+        for node, change in zip(joints, delta):
+            value = predicted[node["joint"]]["position"] + float(change)
+            lower, upper = node["range"]
+            if not lower <= value <= upper or abs(change) > .35:
+                raise PolicyFailure("prediction_rejected", f"Predicted joint limit for {node['joint']}")
+            predicted[node["joint"]]["position"] = value
+        return predicted, delta
+
+    def check(self, actions):
+        values = np.asarray(actions, dtype=float)
+        if values.ndim != 2 or values.shape[1] != 7 or not np.isfinite(values).all() or np.abs(values).max() > 1:
+            raise PolicyFailure("invalid_action", "Invalid normalized action prefix")
+        travel = float(.05 * np.linalg.norm(values[:, :3], axis=1).sum())
+        if travel > .25:
+            raise PolicyFailure("action_outside_authorization", "Prefix translation command exceeds 0.25 m")
+        maximum_joint = 0.0
+        nearest = 1.0
+        # Each OSC command uses feedback at application. Whole-prefix checks use
+        # the measured pose, and the caller repeats this check at every control tick.
+        current = chain_positions(self.rig, self.encoders)
+        position = np.asarray(self.observation["tool"]["p"])
+        for action in values:
+            try:
+                goal = policy_libero_target(action, position)
+            except ValueError as exc:
+                raise PolicyFailure("action_outside_authorization", str(exc)) from exc
+            predicted, delta = self.joint_target(action)
+            maximum_joint = max(maximum_joint, float(np.abs(delta).max()))
+            proposed = chain_positions(self.rig, predicted)
+            for fraction in (.25, .5, .75, 1.0):
+                sweep = current + fraction * (proposed - current)
+                for index, (start, end) in enumerate(zip(sweep, sweep[1:])):
+                    self.require_observed((start + end) / 2, contact=index >= len(sweep) - 3)
+                    self.require_observed(end, contact=index >= len(sweep) - 3)
+                    obstacles = self.points
+                    if index >= len(sweep) - 3:
+                        target_contact = np.linalg.norm(obstacles - self.target, axis=1) < .085
+                        basket_contact = ((np.abs(obstacles[:, :2] - self.basket[:2]).max(axis=1) < .09)
+                                          & (obstacles[:, 2] < .17))
+                        obstacles = obstacles[~(target_contact | basket_contact)]
+                    if len(obstacles):
+                        distance = float(segment_distances(obstacles, start, end).min())
+                        nearest = min(nearest, distance)
+                        if distance < .035:
+                            closest = obstacles[segment_distances(obstacles, start, end).argmin()]
+                            raise PolicyFailure("prediction_rejected", "Observed obstacle intersects predicted arm sweep: "
+                                                f"segment={index}, clearance={distance:.6f}, point={closest.tolist()}")
+                tool = position + fraction * (goal - position)
+                self.require_observed(tool, contact=True)
+                for point in (self.target, self.basket):
+                    if np.linalg.norm(tool[:2] - point[:2]) < .095:
+                        break
+                else:
+                    if len(self.points) and np.linalg.norm(self.points - tool, axis=1).min() < .035:
+                        raise PolicyFailure("prediction_rejected", "Observed obstacle intersects tool sweep")
+        return {"observedPoints": self.observed_points, "minimumObservedClearanceM": nearest,
+                "maximumPredictedJointDeltaRad": maximum_joint, "translationCommandM": travel,
+                "coverage": ["encoder_fk", "joint_limits", "arm_and_tool_sweep", "observed_rgbd_obstacles",
+                             "task_contact_regions", "operating_volume_visibility"],
+                "scope": "calibrated self geometry and observed operating volume"}
diff --git a/steward/src/steward/ego/panda_runtime.py b/steward/src/steward/ego/panda_runtime.py
new file mode 100644
index 0000000000..d13e7ce3b9
--- /dev/null
+++ b/steward/src/steward/ego/panda_runtime.py
@@ -0,0 +1,280 @@
+"""Panda Ego Runtime. Observations enter through the robot port only."""
+
+from __future__ import annotations
+
+import base64
+import copy
+import json
+import logging
+from pathlib import Path
+import threading
+import time
+
+import numpy as np
+
+from steward.ego.panda_observation import PandaObservationRuntime, policy_inputs
+from steward.ego.panda_perception import PandaEvidence
+from steward.ego.panda_jobs import PandaJobs
+from steward.ego.panda_policy import SKILL
+from steward.ego.server import ego_api
+from steward.ego.view import EgoViewRenderer
+from steward.glrender import encode_image
+from steward.net import HttpError, JsonServer, NO_CONTENT
+from steward.scene.schema import Entity, Link, RigidTree, SceneState, exact, pose
+from steward.viewloop import ViewLoop, ViewSettings, frame_response
+
+_LOG = logging.getLogger(__name__)
+
+
+class PandaEgoRuntime:
+    def __init__(self, link, policy_config=None, out_dir=None):
+        self.link = link
+        self.sensor = PandaObservationRuntime(link)
+        self.lock = threading.RLock()
+        self.stop_event = threading.Event()
+        self.thread = None
+        self.latest = None
+        self.inputs = []
+        self.alerts = []
+        self.alert_sequence = 0
+        self.input_lock = threading.Lock()
+        self.out_dir = Path(out_dir) if out_dir else None
+        if self.out_dir is not None:
+            self.out_dir.mkdir(parents=True, exist_ok=True)
+        self.evidence = PandaEvidence()
+        self.scene = SceneState("ego").to_dict()
+        renderer = EgoViewRenderer()
+        self.view = ViewLoop("panda-ego", lambda settings: self._render(renderer, settings), renderer.close)
+        self.executor = PandaJobs(self, policy_config, self.out_dir / "policy-jobs") if policy_config else None
+
+    def start(self):
+        self.view.start()
+        self.thread = threading.Thread(target=self._run, name="panda-observations", daemon=True)
+        self.thread.start()
+
+    def stop(self):
+        if self.executor is not None:
+            self.executor.close()
+        self.stop_event.set()
+        if self.thread is not None:
+            self.thread.join(timeout=5)
+        self.view.stop()
+
+    def _run(self):
+        while not self.stop_event.is_set():
+            try:
+                self.observe()
+            except (OSError, HttpError, ValueError, KeyError) as exc:
+                _LOG.warning("Panda observation unavailable: %s", exc)
+            self.stop_event.wait(0.12)
+
+    def observe(self, force=False):
+        with self.lock:
+            observation = self.sensor.read(force=force)
+            if observation is None:
+                return self.latest
+            tool = observation["tool"]
+            encoders = observation["encoders"]
+            width = abs(encoders["gripper0_finger_joint1"]["position"]
+                        - encoders["gripper0_finger_joint2"]["position"])
+            prefix = f"e:{observation['episodeId']}:"
+            robot = Entity(prefix + "panda", "robot", exact("libero-panda"), exact(tool),
+                           RigidTree(exact("fixed"), [observed_box("tool", [.06, .08, .035])]),
+                           state_vars={"fingerWidth": exact(width)})
+            if self.latest is None or self.latest["episodeId"] != observation["episodeId"]:
+                self.evidence = PandaEvidence()
+            can, basket, grasp, placement, reason = self.evidence.update(observation, width)
+            entities = [robot]
+            for identifier, category, point, size in (
+                (prefix + "can", "alphabet_soup", can, [.062, .062, .075]),
+                (prefix + "basket", "basket", [*basket[0], basket[1] - .065] if basket is not None else None,
+                 [.15, .16, .13]),
+            ):
+                if point is not None:
+                    entities.append(Entity(identifier, "object", exact(category),
+                                           exact({"p": list(point), "q": [1, 0, 0, 0]}),
+                                           RigidTree(exact("fixed"), [observed_box("observed", size)]),
+                                           state_vars={"size": exact(size)}))
+            robot.state_vars.update({"grasp": exact(grasp), "placement": exact(placement)})
+            scene = SceneState("ego", entities=entities, self_id=robot.id,
+                               version=observation["step"], stamp=observation["stamp"])
+            self.scene = scene.to_dict()
+            self.latest = {"episodeId": observation["episodeId"], "step": observation["step"],
+                           "calibrationId": observation["calibrationId"], "scene": self.scene,
+                           "judgment": {"grasp": grasp, "placement": placement, "reason": reason,
+                                        "target": prefix + "can" if can is not None else None,
+                                        "basket": prefix + "basket" if basket is not None else None,
+                                        "evidenceStep": observation["step"]}}
+            self.link.telemetry(self.scene | {"episodeId": observation["episodeId"]})
+            return self.latest
+
+    def policy_observation(self, force=False):
+        with self.lock:
+            self.observe(force=force)
+            if self.latest is None:
+                raise HttpError(409, "Panda has no synchronized observation")
+            return self.sensor.observation, copy.deepcopy(self.latest["judgment"])
+
+    def task_positions(self):
+        with self.lock:
+            if self.evidence.last_can is None or self.evidence.basket is None:
+                raise ValueError("Task objects have insufficient visual evidence")
+            return self.evidence.last_can.copy(), np.array([*self.evidence.basket[0], self.evidence.basket[1] - .065])
+
+    def summary(self):
+        with self.lock:
+            self.observe()
+            if self.latest is None:
+                raise HttpError(409, "Panda has no observation yet")
+            objects = []
+            for entity in self.scene["entities"]:
+                if entity["role"] == "robot":
+                    continue
+                category = entity["category"]["value"]
+                size = entity["stateVars"]["size"]["value"]
+                objects.append({"id": entity["id"], "category": category, "role": category,
+                    "position": entity["pose"]["value"]["p"], "sizeM": size, "extentM": size,
+                    "existence": 1.0, "lastSeenAgoS": 0.0,
+                    "on": (self.latest["judgment"]["basket"] if category == "alphabet_soup"
+                           and self.latest["judgment"]["placement"] == "confirmed" else None),
+                    "categories": {category: 1.0}, "uncertaintyM": .015})
+            job = self.executor.current.to_dict() if self.executor and self.executor.current else None
+            width = abs(self.sensor.observation["encoders"]["gripper0_finger_joint1"]["position"]
+                        - self.sensor.observation["encoders"]["gripper0_finger_joint2"]["position"])
+            return {"episodeId": self.latest["episodeId"], "stamp": self.sensor.observation["stamp"],
+                    "version": self.latest["step"], "body": "libero-panda", "self": {
+                        "toolPose": self.sensor.observation["tool"], "grasp": self.latest["judgment"]["grasp"],
+                        "holding": (f"e:{self.latest['episodeId']}:can" if self.latest["judgment"]["grasp"] == "confirmed"
+                                    and width < .071 and self.evidence.release is None else None)},
+                    "objects": objects, "judgment": copy.deepcopy(self.latest["judgment"]), "job": job,
+                    "skills": [SKILL] if self.executor else []}
+
+    def query(self, category=None, near=None, radius=None):
+        objects = self.summary()["objects"]
+        if near:
+            anchor = next((obj for obj in objects if obj["id"] == near), None)
+            if anchor is None:
+                raise ValueError("Unknown Ego-State reference")
+            objects = [obj for obj in objects if obj["id"] != near and np.linalg.norm(
+                np.subtract(obj["position"], anchor["position"])) <= (1.0 if radius is None else radius)]
+        return [obj for obj in objects if category is None or obj["category"] == category]
+
+    def jobs(self):
+        if self.executor is None:
+            raise HttpError(409, "Panda policy is not configured")
+        return self.executor
+
+    def apply(self, request, operation):
+        result = operation()
+        record = request | {"episodeId": self.latest["episodeId"] if self.latest else None,
+                            "wallMonotonic": time.monotonic()}
+        with self.input_lock:
+            self.inputs.append(record)
+            if self.out_dir:
+                with (self.out_dir / "api-inputs.jsonl").open("a") as stream:
+                    stream.write(json.dumps(record) + "\n")
+        return result
+
+    def alert(self, message, source, level="error", goal="", step="", diagnosis=""):
+        _LOG.warning("%s: %s", source, message)
+        with self.input_lock:
+            self.alert_sequence += 1
+            record = {"id": self.alert_sequence, "t": self.latest["scene"]["stamp"] if self.latest else 0,
+                      "source": source, "level": level, "message": message[:2000], "count": 1,
+                      "acknowledged": False, "goal": goal[:2000], "step": step[:2000],
+                      "diagnosis": diagnosis[:2000]}
+            self.alerts.append(record)
+            del self.alerts[:-50]
+            return dict(record)
+
+    def alerts_view(self, acknowledge=False, identifier=None):
+        with self.input_lock:
+            if acknowledge:
+                for record in self.alerts:
+                    if identifier is None or record["id"] == identifier:
+                        record["acknowledged"] = True
+            return {"alerts": copy.deepcopy(self.alerts),
+                    "active": [dict(record) for record in self.alerts if not record["acknowledged"]]}
+
+    def reflect(self, failure):
+        """Report the current policy failure from robot-local evidence without proposing a retry."""
+        job = self.summary()["job"]
+        reason = job["reasonCode"] if job and job["state"] != "running" else "task_unconfirmed"
+        return {"cause": {"key": reason, "label": reason,
+                          "advice": "End dependent work; report the Job, goalStatus and stopStatus to the operator."},
+                "sought": {"name": failure.get("name"), "size": failure.get("size")},
+                "targets": [], "missing": [], "candidates": []}
+
+    def plan_view(self):
+        summary = self.summary()
+        job = summary["job"]
+        return {"plan": None, "skill": job if job and job["state"] == "running" else None,
+                "activity": [], "activityLast": 0, "boot": str(id(self)), "t": summary["stamp"]}
+
+    def preview(self):
+        with self.lock:
+            observation = self.sensor.observation
+            if observation is None:
+                raise HttpError(409, "Panda has no observation yet")
+            try:
+                inputs = policy_inputs(observation)
+            except ValueError as exc:
+                raise HttpError(409, str(exc)) from exc
+            return {"episodeId": observation["episodeId"], "step": observation["step"],
+                    "observation/state": inputs["observation/state"].tolist(),
+                    **{key: base64.b64encode(encode_image(inputs[key])).decode("ascii")
+                       for key in ("observation/image", "observation/wrist_image")}}
+
+    def state(self):
+        return self.latest
+
+    def _render(self, renderer, settings):
+        scene = self.scene
+        return renderer.render(scene, settings), "image/jpeg", {"esVersion": scene["version"], "t": scene["stamp"]}
+
+
+def observed_box(name, size):
+    return Link(name, name, {"collision": [
+        {"kind": "primitive", "shape": "box", "size": size, "pose": pose()}
+    ]})
+
+
+def panda_ego_api(runtime, port, bind_wait_s):
+    def frame(query, body):
+        latest = runtime.view.latest(int(query["after"]) if "after" in query else None)
+        status = runtime.view.status()
+        if latest is not None:
+            return frame_response(latest, status)
+        if status["settings"] is None:
+            raise HttpError(409, "the ego view is not configured")
+        if status["error"]:
+            raise HttpError(503, status["error"])
+        return NO_CONTENT
+
+    routes = {
+        ("GET", "/ego/observation"): lambda q, b: runtime.preview(),
+        ("GET", "/ego/state"): lambda q, b: runtime.state(),
+        ("POST", "/ego/observe"): lambda q, b: runtime.observe(),
+        ("GET", "/ego/view"): lambda q, b: runtime.view.status(),
+        ("POST", "/ego/view"): lambda q, b: runtime.view.configure(ViewSettings.parse(b)),
+        ("GET", "/ego/view/frame"): frame,
+        ("GET", "/ego/summary"): lambda q, b: runtime.summary(),
+        ("GET", "/ego/query"): lambda q, b: {"objects": runtime.query(q.get("category"), q.get("near"),
+                                                   float(q["radius"]) if "radius" in q else None)},
+        ("POST", "/ego/predict"): lambda q, b: runtime.jobs().predict(b["skill"], b.get("params", {})),
+        ("GET", "/ego/receipt"): lambda q, b: runtime.jobs().receipt(q["id"]),
+        ("GET", "/ego/control"): lambda q, b: runtime.jobs().control(),
+        ("POST", "/ego/control"): lambda q, b: runtime.jobs().control(b.get("action"), b.get("owner")),
+        ("POST", "/skill/run"): lambda q, b: runtime.jobs().run(b["receipt"], b.get("owner")),
+        ("GET", "/skill/status"): lambda q, b: runtime.jobs().job(q["job"]),
+        ("POST", "/skill/wait"): lambda q, b: runtime.jobs().wait(b["job"], float(b.get("timeoutS", 120))),
+        ("POST", "/skill/stop"): lambda q, b: runtime.jobs().stop(),
+        ("GET", "/ego/inputs"): lambda q, b: {"inputs": runtime.inputs},
+        ("POST", "/ego/alert"): lambda q, b: runtime.alert(b.get("message", ""), b.get("source", "agent"),
+                    b.get("level", "error"), b.get("goal", ""), b.get("step", ""), b.get("diagnosis", "")),
